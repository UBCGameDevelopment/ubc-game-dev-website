---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import MissionSection from "../components/home/MissionSection.astro";
import EventsPreview from "../components/home/EventsPreview.astro";
import ProjectsPreview from "../components/home/ProjectsPreview.astro";
import FAQSection from "../components/home/FAQSection.astro";

const faqs = [
  {
    q: "What is UBC Game Dev?",
    a: "We are a student-run game development club comprised of programmers, artists, writers, designers, and musicians. Through us, you can form a team with members of different disciplines and plan your own projects. We are open to UBC and non-UBC members.",
  },
  {
    q: "What type of events do you host?",
    a: "We host weekly team meetings, workshops, game nights, and other fun activities to expand your game development horizons, along with social events to help you bond with other members.",
  },
  {
    q: "Do you need experience?",
    a: "No experience is required. You do not need to know much about game development to join UBC Game Dev. Throughout the semester, there are workshops to teach you valuable skills, and both execs and experienced members are there to help.",
  },
];
---

<Layout
  title="UBC Game Dev | Home"
  immersive
>
  <HeroSection />
  <MissionSection />
  <FAQSection faqs={faqs} />
  <EventsPreview />
  <ProjectsPreview />
</Layout>
