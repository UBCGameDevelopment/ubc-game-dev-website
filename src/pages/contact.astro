---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/home/ContactForm";
import CyberBadge from "../components/common/CyberBadge.astro";
---

<Layout title="UBC Game Dev | Contact">
  <div class="mx-auto mt-24 mb-12 max-w-3xl text-center">
    <div class="mb-6 flex items-center justify-center gap-4">
      <span class="hidden h-px w-10 bg-[var(--brand)] opacity-80 md:block"></span>
      <CyberBadge
        label="CONTACT US"
        variant="brand"
      />
      <span class="hidden h-px w-10 bg-[var(--brand)] opacity-80 md:block"></span>
    </div>

    <h1 class="font-pixel text-4xl font-extrabold tracking-tight text-[var(--text)] uppercase md:text-5xl">
      Get in <span class="text-[var(--cyber-yellow)]">Touch</span>
    </h1>
    <p class="font-tech mt-4 text-sm text-[var(--text-muted)] md:text-base">
      Have a question or want to collaborate? Send us a message and we'll get back to you!
    </p>
  </div>

  <ContactForm client:load />
</Layout>
