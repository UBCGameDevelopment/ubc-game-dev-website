---
import Layout from "../layouts/Layout.astro";
import { GameService } from "../services";
import BackgroundText from "../components/effects/BackgroundText.astro";
import TimelineSidebar from "../components/games/TimelineSidebar.astro";
import GameArticle from "../components/games/GameArticle.astro";
import PageHeader from "../components/common/PageHeader.astro";

const { years, gamesByYear } = GameService.getGroupedByYearSorted();
---

<Layout title="UBC Game Dev | Projects">
  <PageHeader
    backgroundText="DATABASE"
    badge={{ label: "Past Works", variant: "blue" }}
    title={{ normal: "", highlight: "Projects" }}
    gradientClass="from-[var(--cyber-blue)] to-[var(--brand)]"
    description="Trace the history of our digital creations. From game jam prototypes to polished releases, explore the legacy of UBC Game Dev code."
    descriptionBorderColor="border-[var(--cyber-blue)]"
    glowColor="var(--brand)"
  />

  <div class="container-page relative z-10 mx-auto flex min-h-screen flex-col gap-8 px-4 pb-24 md:flex-row lg:gap-16">
    <TimelineSidebar years={years} />

    <div class="flex-1 space-y-32">
      {
        years.map((year) => (
          <div
            data-year-section={year}
            class:list={["relative", year === years[0] ? "" : "hidden"]}>
            <div class="mb-12 flex items-center gap-4">
              <BackgroundText
                text={year}
                className="text-6xl -top-10 -left-4 md:-left-12 opacity-40"
              />
              <h3 class="relative z-10 flex items-center gap-2 text-3xl font-bold text-[var(--cyber-yellow)]">
                <span>{year}</span>
              </h3>
              <div class="ml-4 h-px flex-1 bg-[var(--border-dim)]" />
            </div>

            <div class="space-y-16">
              {gamesByYear[year].map((game) => (
                <GameArticle game={game} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-year-tab]");
  const sections = document.querySelectorAll<HTMLElement>("[data-year-section]");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const selectedYear = tab.dataset.yearTab;
      if (!selectedYear) return;

      tabs.forEach((item) => {
        const isSelected = item === tab;
        item.setAttribute("aria-selected", String(isSelected));
        item.classList.toggle("border-[var(--cyber-yellow)]", isSelected);
        item.classList.toggle("bg-[var(--bg-deep)]", isSelected);
        item.classList.toggle("text-white", isSelected);
        item.classList.toggle("border-transparent", !isSelected);
        item.classList.toggle("text-[var(--text-muted)]", !isSelected);
      });

      sections.forEach((section) => {
        section.classList.toggle("hidden", section.dataset.yearSection !== selectedYear);
      });
    });
  });
</script>
