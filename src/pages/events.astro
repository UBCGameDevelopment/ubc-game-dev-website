---
import Layout from "../layouts/Layout.astro";
import LevelCard from "../components/events/LevelCard.astro";
import EventModal from "../components/events/EventModal";
import { EventService } from "../services";
import PageHeader from "../components/common/PageHeader.astro";

const events = EventService.getAll();
const eventsForModal = EventService.prepareForModal(events);
---

<Layout title="UBC Game Dev | Events">
  <main>
    <PageHeader
      backgroundText="CHAPTERS"
      badge={{ label: "Season 2025-2026 // Active", variant: "brand" }}
      title={{ normal: "Event ", highlight: "Chapters" }}
      gradientClass="from-[var(--cyber-yellow)] to-[var(--brand)]"
      description="Explore workshops, showcases, socials, and other club events happening throughout the year at UBC Game Dev."
      descriptionBorderColor="border-[var(--cyber-yellow)]"
      glowColor="var(--brand)"
    />

    <section class="container-page mx-auto px-4 pb-20">
      <div class="grid justify-items-center gap-6 sm:grid-cols-2 sm:justify-items-stretch lg:grid-cols-3">
        {
          events.map((event, index) => (
            <LevelCard
              {...event}
              chapterNumber={index + 1}
            />
          ))
        }
      </div>
    </section>

    <EventModal
      client:load
      events={eventsForModal}
    />
  </main>
</Layout>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const button = target.closest("[data-open-modal]");
    if (button) {
      const index = parseInt(button.getAttribute("data-open-modal") || "0", 10);
      window.dispatchEvent(new CustomEvent("openEventModal", { detail: { index } }));
    }
  });
</script>
