---
import PageHeader from "../common/PageHeader.astro";
---

<PageHeader
  backgroundText="MERCH"
  badge={{ label: "Club Merch", variant: "blue" }}
  title={{ normal: "Club ", highlight: "Merch" }}
  gradientClass="from-[var(--cyber-blue)] to-[var(--cyber-magenta)]"
  description="Browse official UBC Game Dev merchandise. Every purchase supports club operations, workshops, and student showcases."
  descriptionBorderColor="border-[var(--cyber-blue)]"
  glowColor="var(--cyber-blue)"
/>
