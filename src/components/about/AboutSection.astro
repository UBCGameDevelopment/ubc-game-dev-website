---
import CyberSettingsMenu from "./CyberSettingsMenu";
import PageHeader from "../common/PageHeader.astro";
---

<section>
  <PageHeader
    backgroundText="ABOUT"
    badge={{ label: "Student-Run Club", variant: "brand" }}
    title={{ normal: "About ", highlight: "US" }}
    gradientClass="from-[var(--brand)] to-[var(--cyber-yellow)]"
    description="Learn what the club does, how members get involved, and how we help students build games together."
    descriptionBorderColor="border-[var(--brand)]"
    glowColor="var(--brand)"
  />

  <div class="container-page px-4 pb-20 md:pb-24">
    <CyberSettingsMenu client:load />
  </div>
</section>
