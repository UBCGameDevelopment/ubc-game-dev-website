---
import type { Event } from "../../types";
import { EventService } from "../../services/EventService";
import EventText from "./EventText";

export interface Props extends Event {
  chapterNumber: number;
}

const { title, date, description, location, mapLink, image, additionalImages, isoDate, chapterNumber } = Astro.props;
const hasGallery = Boolean(additionalImages?.length);
const status = EventService.getStatus(isoDate);
const isAvailable = status !== "complete";
const statusLabel = status === "upcoming" ? "Upcoming" : status === "active" ? "Active" : "Complete";
---

<div
  data-open-modal={isAvailable ? chapterNumber - 1 : undefined}
  class:list={[
    "angular-card relative flex w-full max-w-[24rem] flex-col overflow-hidden md:max-w-none",
    isAvailable
      ? "cursor-pointer bg-[var(--surface-2)]"
      : "pointer-events-none bg-[var(--surface-2)]/30 opacity-60 grayscale select-none",
  ]}
>
  <div class="relative aspect-video shrink-0 overflow-hidden">
    <img
      src={image.src}
      alt={title}
      width={image.width}
      height={image.height}
      class:list={[
        "block h-full w-full",
        hasGallery ? "object-contain" : "object-cover",
      ]}
      loading="lazy"
      decoding="async"
    />
    {
      !hasGallery && (
        <div class="absolute inset-0 bg-gradient-to-t from-[var(--surface-2)] via-[var(--surface-2)]/30 via-30% to-transparent" />
      )
    }

    <div
      class:list={[
        "font-pixel absolute top-0 left-0 z-20 flex h-12 w-12 items-center justify-center text-lg font-bold shadow-lg md:h-14 md:w-14 md:text-xl",
        isAvailable ? "bg-[var(--cyber-yellow)] text-[var(--surface)]" : "bg-[var(--surface-3)] text-[var(--text-muted)]",
      ]}
      style="clip-path: polygon(0 0, 100% 0, 100% 100%, 0 calc(100% - 15px));"
    >
      {chapterNumber}
    </div>

    <div
      class:list={[
        "font-tech absolute top-3 right-3 z-20 inline-flex items-center justify-center border-l-2 bg-black/80 px-2.5 py-1.5 text-xs font-bold tracking-[0.12em] whitespace-nowrap uppercase backdrop-blur-sm md:top-4 md:right-4",
        isAvailable ? "border-[var(--cyber-yellow)] text-[var(--cyber-yellow)]" : "border-slate-400 text-slate-200",
      ]}
      style="clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);"
    >
      {statusLabel}
    </div>

    {isAvailable && <div class="absolute right-0 bottom-0 h-1 w-16 bg-[var(--cyber-yellow)]" />}
  </div>

  <div class="relative flex flex-1 flex-col p-5 md:p-6">
    <h3 class="font-pixel text-lg text-[var(--text)] sm:text-xl md:text-2xl">
      {title}
    </h3>

    <div class="font-tech mt-2.5 flex flex-col gap-2 text-sm text-[var(--text-muted)] md:mt-3">
      <div class="flex items-center gap-2 text-[var(--brand)]">
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <rect
            x="3"
            y="4"
            width="18"
            height="18"
            rx="2"
            ry="2"
            stroke-width="2"
          >
          </rect>
          <line
            x1="16"
            y1="2"
            x2="16"
            y2="6"
            stroke-width="2"
          >
          </line>
          <line
            x1="8"
            y1="2"
            x2="8"
            y2="6"
            stroke-width="2"
          >
          </line>
          <line
            x1="3"
            y1="10"
            x2="21"
            y2="10"
            stroke-width="2"
          >
          </line>
        </svg>
        <span class="font-bold">{date}</span>
      </div>
      {
        location && (
          <div class="flex items-center gap-2">
            <svg
              class="h-4 w-4 text-[var(--cyber-magenta)]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>
            {mapLink && isAvailable ? (
              <a
                href={mapLink}
                target="_blank"
                class="font-medium text-[var(--text)] underline decoration-dotted"
              >
                {location}
              </a>
            ) : (
              <span class="font-medium text-[var(--text)]">{location}</span>
            )}
          </div>
        )
      }
    </div>

    <p
      class="mt-3 line-clamp-2 border-l-2 border-[var(--border)] pl-3 text-base leading-relaxed text-[var(--text-muted)] md:mt-4"
    >
      <EventText text={description} />
    </p>

    {
      isAvailable && (
        <div class="mt-auto pt-5 md:pt-6">
          <button
            type="button"
            data-open-modal={chapterNumber - 1}
            class="clip-angled relative w-full bg-[var(--cyber-yellow)] p-px text-black uppercase"
          >
            <span class="font-pixel clip-angled relative z-10 flex items-center justify-center gap-2 bg-[var(--cyber-yellow)] px-5 py-3 text-sm font-bold tracking-widest md:px-6">
              DETAILS
              <svg
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </span>
          </button>
        </div>
      )
    }
  </div>
</div>
