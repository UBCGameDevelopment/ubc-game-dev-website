---
import BackgroundText from "../effects/BackgroundText.astro";
import CyberBadge from "./CyberBadge.astro";

interface Props {
  backgroundText: string;
  badge: {
    label: string;
    variant: "brand" | "accent" | "yellow" | "magenta" | "blue";
  };
  title: {
    normal: string;
    highlight: string;
  };
  gradientClass: string; // e.g. "from-[var(--brand)] to-[var(--cyber-yellow)]"
  description: string;
  descriptionBorderColor?: string; // e.g. "border-[var(--brand)]"
  glowColor?: string;
}

const {
  backgroundText,
  badge,
  title,
  gradientClass,
  description,
  descriptionBorderColor = "border-[var(--brand)]",
} = Astro.props;
---

<section class="relative overflow-hidden pt-36 pb-16 md:pb-24">
  <div class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center">
    <div
      class="absolute inset-0 bg-[linear-gradient(rgba(var(--brand-rgb),0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(var(--brand-rgb),0.02)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_70%)] bg-[size:4rem_4rem]"
    >
    </div>
  </div>

  <div class="container-page relative z-10 mx-auto px-4 text-center">
    <BackgroundText
      text={backgroundText}
      className="top-2 left-1/2 -translate-x-1/2 text-8xl font-black tracking-tighter opacity-[0.025] md:text-[11rem]"
    />

    <div class="mb-4 inline-flex justify-center opacity-85">
      <CyberBadge
        label={badge.label}
        variant={badge.variant}
      />
    </div>

    <h1 class="mb-5 flex items-center justify-center">
      <span class="font-display text-5xl font-black tracking-tight text-white uppercase md:text-7xl lg:text-8xl">
        {title.normal}
        <span class="text-white">{title.highlight}</span>
      </span>
    </h1>

    <p
      class:list={[
        "mx-auto mt-4 max-w-xl text-base leading-relaxed text-[var(--text-muted)] md:text-center md:text-lg",
        descriptionBorderColor,
      ]}
    >
      {description}
    </p>

    <slot />
  </div>
</section>
