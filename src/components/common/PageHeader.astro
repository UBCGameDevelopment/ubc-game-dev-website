---
import CyberBadge from "./CyberBadge.astro";

interface Props {
  badge?: {
    label: string;
    variant: "brand" | "accent" | "yellow" | "magenta" | "blue" | "neutral";
  };
  title: string;
  description: string;
}

const { badge, title, description } = Astro.props;

const accentLines = {
  brand: "bg-[var(--brand)]",
  accent: "bg-[var(--accent)]",
  yellow: "bg-[var(--cyber-yellow)]",
  magenta: "bg-[var(--accent)]",
  blue: "bg-[var(--cyber-blue)]",
  neutral: "bg-[var(--border-dim)]",
} as const;

const line = badge ? accentLines[badge.variant] : "";
---

<section class="relative overflow-hidden pt-36 pb-16 md:pb-24">
  <div class="pointer-events-none absolute inset-0 z-0">
    <div class="absolute inset-x-0 top-0 h-px bg-white/8"></div>
  </div>

  <div class="container-page relative z-10 mx-auto px-4">
    <div class="mx-auto max-w-5xl py-4 text-center md:py-8">
      {badge && (
        <div class="mb-6 flex items-center justify-center gap-4">
          <span class:list={["hidden h-px w-10 shrink-0 opacity-80 md:block", line]}></span>
          <CyberBadge label={badge.label} variant={badge.variant} />
          <span class:list={["hidden h-px w-10 shrink-0 opacity-80 md:block", line]}></span>
        </div>
      )}

      <h1 class="text-4xl font-black tracking-[-0.05em] text-white uppercase md:text-6xl lg:text-[5rem]">
        {title}
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-base text-[var(--text-muted)] md:text-lg">
        {description}
      </p>
    </div>
  </div>
</section>
