---
interface Props {
  years: string[];
}

const { years } = Astro.props;
---

<aside class="h-fit w-full shrink-0 md:sticky md:top-32 md:w-64">
  <div class="hud-card border border-[var(--border-dim)] bg-[var(--bg-panel)]/80 p-6 backdrop-blur-md">
    <h2 class="mb-6 border-b border-[var(--border-dim)] pb-4 text-2xl font-black tracking-widest text-white uppercase">
      Club Timeline
    </h2>

    <nav class="space-y-2">
      {
        years.map((year) => (
          <button
            type="button"
            data-year-tab={year}
            aria-selected={year === years[0] ? "true" : "false"}
            class:list={[
              "year-tab font-tech block w-full rounded border-l-2 px-4 py-3 text-left text-lg tracking-wider",
              year === years[0]
                ? "border-[var(--cyber-yellow)] bg-[var(--bg-deep)] text-white"
                : "border-transparent text-[var(--text-muted)]",
            ]}>
            <span class="mr-2 text-[var(--cyber-yellow)]">//</span> {year}
          </button>
        ))
      }
    </nav>
  </div>
</aside>

<style>
  .year-tab {
    cursor: pointer;
  }

  .year-tab[aria-selected="true"] {
    font-weight: 700;
  }
</style>
