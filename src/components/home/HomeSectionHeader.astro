---
interface Props {
  label: string;
  title: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
  titleClass?: string;
}

const {
  label,
  title,
  description,
  actionHref,
  actionLabel,
  titleClass = "text-3xl md:text-5xl",
} = Astro.props;
---

<div class="mb-16 border-b border-[var(--border-dim)] pb-6">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="space-y-5">
      <div
        class="inline-flex items-center gap-3 border border-[var(--border-dim)] bg-[var(--bg-panel)]/70 px-4 py-2 font-tech text-[11px] tracking-[0.24em] text-[var(--cyber-blue)] uppercase"
        style="clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%, 0 12px);"
      >
        <span class="h-1.5 w-1.5 bg-[var(--cyber-blue)]"></span>
        {label}
      </div>

      <h2 class:list={["max-w-3xl font-black tracking-[-0.05em] text-white uppercase", titleClass]}>
        {title}
      </h2>

      {
        description && (
          <p class="max-w-2xl text-lg leading-relaxed text-[var(--text-muted)] md:text-xl">
            {description}
          </p>
        )
      }
    </div>

    {
      actionHref &&
        actionLabel && (
          <a
            href={actionHref}
            class="font-tech shrink-0 text-xs tracking-[0.2em] text-[var(--text-muted)] uppercase transition-colors hover:text-white"
          >
            {actionLabel}
          </a>
        )
    }
  </div>
</div>
