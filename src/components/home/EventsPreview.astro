---
import { EventService } from "../../services/EventService";
import HomeSectionHeader from "./HomeSectionHeader.astro";
import EventText from "../events/EventText";

const latestEvents = EventService.getLatest(2);
const getPreviewText = (html: string) =>
  html
    .replace(/<br\s*\/?>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
---

<section class="section-block relative z-10 overflow-hidden py-24">
  <div class="container-page relative z-10 mx-auto px-4">
    <HomeSectionHeader
      label="Events"
      title="CLUB <span class='text-[var(--text-muted)]'>EVENTS</span>"
      actionHref="/events"
      actionLabel="View All"
      wrapperClass="mb-8 md:mb-10"
    />

    <div class="grid justify-items-center gap-6 md:grid-cols-2 md:justify-items-stretch">
      {
        latestEvents.length > 0 ? (
          latestEvents.map((event) => {
            const status = EventService.getStatus(event.isoDate);
            const statusLabel = status === "upcoming" ? "Upcoming" : status === "active" ? "Active" : "Complete";

            return (
            <div class="hud-card group w-full max-w-[24rem] p-5 transition-all hover:border-[var(--cyber-red)] hover:bg-[var(--bg-panel)] md:max-w-none md:p-6">
              <div class="flex flex-col gap-5 md:flex-row md:gap-6">
                <div
                  class:list={[
                    "h-44 w-full shrink-0 border border-[var(--border-dim)] bg-cover bg-center transition-all md:aspect-square md:h-auto md:w-48",
                    status === "complete" ? "grayscale group-hover:grayscale-0" : "",
                  ]}
                  style={`background-image: url('${event.image.src}');`}
                />

                <div class="flex-1">
                  <div class="mb-2 flex items-center justify-between">
                    <span
                      class={`px-2 py-0.5 text-xs font-bold tracking-wider uppercase ${
                        status === "active"
                          ? "bg-[var(--cyber-red)] text-white"
                          : status === "upcoming"
                            ? "bg-[var(--cyber-yellow)] text-black"
                            : "bg-[var(--text-muted)] text-black"
                      }`}
                    >
                      {statusLabel}
                    </span>
                    <span class="font-tech text-base text-[var(--cyber-yellow)]">
                      {new Date(event.isoDate).toLocaleDateString()}
                    </span>
                  </div>
                  <h3 class="mb-2 text-2xl font-bold text-white">{event.title}</h3>
                  <p class="mb-4 line-clamp-2 text-base text-[var(--text-muted)]">
                    <EventText text={getPreviewText(event.description)} />
                  </p>
                  {event.location && (
                    <div class="font-tech flex items-center gap-2 text-sm text-[var(--text-muted)]">
                      <span
                        class={`h-2 w-2 rounded-full ${status === "complete" ? "bg-[var(--text-muted)]" : "bg-[var(--cyber-blue)]"}`}
                      />
                      {event.location}
                    </div>
                  )}
                </div>
              </div>
            </div>
            );
          })
        ) : (
          <div class="font-tech col-span-2 border border-dashed border-[var(--border-dim)] p-8 text-center text-[var(--text-muted)]">
            [NO OPERATIONS DETECTED] <br /> Check back later for mission updates.
          </div>
        )
      }
    </div>
  </div>
</section>
