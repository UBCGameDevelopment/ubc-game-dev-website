---
import { GameService } from "../../services";
import HomeSectionHeader from "./HomeSectionHeader.astro";

const featuredGames = GameService.getFeatured(3);
---

<section class="section-block relative z-10 overflow-hidden py-24">
  <div class="container-page relative z-10 mx-auto px-4">
    <HomeSectionHeader
      label="Projects"
      title="Featured Projects"
      actionHref="/games"
      actionLabel="View All"
    />

    <div
      class="scrollbar-none grid snap-x snap-mandatory auto-cols-[84%] grid-flow-col gap-4 overflow-x-auto pb-2 md:snap-none md:auto-cols-auto md:grid-flow-row md:grid-cols-2 md:justify-items-stretch md:gap-8 md:overflow-visible md:pb-0 lg:grid-cols-3"
    >
      {
        featuredGames.map((game, index) => {
          let imageSrc = "/assets/placeholder-game.png";
          if (game.media && game.media.image) {
            imageSrc = game.media.image.src;
          } else if (game.media && game.media.images && game.media.images.length > 0) {
            imageSrc = game.media.images[0].src;
          }

          return (
            <a
              href={game.gameLink || "#"}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block w-full snap-center overflow-hidden border border-[var(--border-dim)] bg-[#0c0c0c] transition-all hover:border-[var(--cyber-blue)] hover:shadow-[0_0_30px_rgba(0,240,255,0.15)] md:snap-none"
              style={`clip-path: polygon(0 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%); animation-delay: ${index * 0.15}s`}
            >
              <div class="flex items-center justify-between border-b border-[var(--border-dim)] bg-[#151515] px-4 py-2 text-[10px] font-bold tracking-[0.2em] text-[var(--text-muted)] uppercase transition-colors group-hover:text-[var(--cyber-blue)]">
                <span>FILE_ID :: 0{index + 1}</span>
                <span class="flex items-center gap-2">
                  {game.year} <div class="h-1 w-1 bg-[var(--cyber-yellow)]" />
                </span>
              </div>

              <div class="relative aspect-video overflow-hidden">
                <div
                  class="h-full w-full bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
                  style={`background-image: url('${imageSrc}');`}
                >
                  <div class="absolute inset-0 bg-[#0c0c0c]/40 transition-colors duration-500 group-hover:bg-transparent" />
                </div>

                <div class="pointer-events-none absolute inset-0 z-10 bg-[linear-gradient(rgba(0,240,255,0)_50%,rgba(0,240,255,0.1)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_4px,3px_100%] opacity-0 transition-opacity group-hover:opacity-100" />

                {game.award && (
                  <div class="absolute right-0 bottom-0 z-20 p-2">
                    <span
                      class="bg-[var(--cyber-yellow)] px-2 py-1 text-[10px] font-bold tracking-wider text-black uppercase shadow-[0_0_10px_rgba(252,238,10,0.5)]"
                      style="clip-path: polygon(10px 0, 100% 0, 100% 100%, 0 100%);"
                    >
                      {game.award}
                    </span>
                  </div>
                )}
              </div>

              <div class="relative p-6">
                <h3 class="font-display flex items-center gap-2 text-2xl font-black text-white uppercase transition-colors group-hover:text-[var(--cyber-blue)]">
                  <span class="-translate-x-2 text-[var(--cyber-blue)] opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">
                    >
                  </span>
                  {game.name}
                </h3>

                <p class="mt-3 line-clamp-2 font-mono text-sm leading-relaxed text-[var(--text-muted)] transition-colors group-hover:text-gray-300">
                  {game.description}
                </p>

                <div class="mt-6 flex flex-wrap gap-2 border-t border-dashed border-[var(--border-dim)] pt-4 opacity-60 transition-opacity group-hover:opacity-100">
                  <span class="font-tech text-xs tracking-wider text-[var(--cyber-blue)] uppercase">
                    STATUS: DEPLOYED
                  </span>
                </div>
              </div>

              <div class="absolute right-0 bottom-0 h-4 w-4 border-r-2 border-b-2 border-[var(--cyber-blue)] opacity-0 transition-opacity group-hover:opacity-100" />
            </a>
          );
        })
      }
    </div>
  </div>
</section>
