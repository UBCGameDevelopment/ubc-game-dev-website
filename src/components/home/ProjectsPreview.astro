---
import { GameService } from "../../services";
import HomeSectionHeader from "./HomeSectionHeader.astro";

const featuredGames = GameService.getFeatured(3);
---

<section class="section-block relative z-10 overflow-hidden py-24">
  <div class="container-page relative z-10 mx-auto px-4">
    <HomeSectionHeader
      label="Projects"
      title="LATEST PROJECTS"
      actionHref="/games"
      actionLabel="View All"
      wrapperClass="mb-8 md:mb-10"
    />

    <div
      class="scrollbar-none grid snap-x snap-mandatory auto-cols-[84%] grid-flow-col gap-4 overflow-x-auto pb-2 md:snap-none md:auto-cols-auto md:grid-flow-row md:grid-cols-2 md:justify-items-stretch md:gap-8 md:overflow-visible md:pb-0 lg:grid-cols-3"
    >
      {
        featuredGames.map((game) => {
          let imageSrc = "/assets/placeholder-game.png";
          if (game.media && game.media.image) {
            imageSrc = game.media.image.src;
          } else if (game.media && game.media.images && game.media.images.length > 0) {
            imageSrc = game.media.images[0].src;
          }

          return (
            <a
              href={game.gameLink || "#"}
              target="_blank"
              rel="noopener noreferrer"
              class="relative block w-full snap-center overflow-hidden border border-[var(--border-dim)] bg-[var(--bg-panel)] md:snap-none"
            >
              <div class="relative aspect-video overflow-hidden">
                <img
                  src={imageSrc}
                  alt={`${game.name} game preview`}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />

                {game.award && (
                  <div class="absolute right-3 bottom-3 z-20">
                    <span class="bg-[var(--cyber-yellow)] px-2 py-1 text-[10px] font-bold tracking-wider text-black uppercase">
                      {game.award}
                    </span>
                  </div>
                )}
              </div>

              <div class="relative p-6">
                <h3 class="font-display text-2xl font-black text-white uppercase">{game.name}</h3>

                <p class="mt-3 line-clamp-2 font-mono text-sm leading-relaxed text-[var(--text-muted)]">
                  {game.description}
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
